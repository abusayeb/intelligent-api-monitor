PORT=4000
LOG_LEVEL=info

# local mongo or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/api_monitor

# anything slower than SLOW is flagged, slower than CRITICAL is flagged as high
SLOW_RESPONSE_MS=2000
CRITICAL_RESPONSE_MS=5000

MAX_BATCH_SIZE=500
WRITE_CONCURRENCY=10

# free key from https://aistudio.google.com/apikey
# leave empty to use template alerts only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=2
AI_BATCH_SIZE=10
AI_CONCURRENCY=2
